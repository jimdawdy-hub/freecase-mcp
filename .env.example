# freecase-mcp configuration
#
# Copy this file to `.env` (which is git-ignored) OR set these as environment
# variables in your MCP host's config. Most subscribers set them directly in
# their agent's config file (see README.md) and never create a .env at all.

# Your personal connector key. Generate one on your Freecase account page.
# It always starts with "fc_mcp_". Required for search_cases and
# search_statutes; the other three tools work without it.
#
# Treat this like a password: do not commit it, do not share it. If it leaks,
# revoke it from your account page and generate a new one.
FREECASE_MCP_KEY=fc_mcp_your_key_here

# The Freecase backend to talk to. Leave unset to use production.
# Only override this for local development or staging.
FREECASE_API_BASE=https://api.freecase.ai
